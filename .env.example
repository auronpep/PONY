# Copy to .env (gitignored) and fill in.
# promptfoo reads .env from the current directory, so it is picked up automatically
# when you run from the repo root. From benchmarks/, pass --env-file ../.env.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for the OpenAI arms (promptfooconfig.gpt.yaml,
# promptfooconfig.gpt-newest.yaml, benchmarks/robustness-audit.js). Uncomment and fill in.
#OPENAI_API_KEY=sk-...

# Only needed for the Gemini arm (promptfooconfig.gemini.yaml, key from AI Studio).
#GOOGLE_API_KEY=...
